# REVALTO - ENVIRONMENT VARIABLES TEMPLATE

# 1. Google Gemini API Key and Google Auth Client ID
# Get a free API key from Google AI Studio at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"

# 2. Database URL Configuration
# If using SQLite locally (default):
DATABASE_URL="file:./dev.db"

# If switching to Supabase PostgreSQL:
# 1. Create a database on https://supabase.com/
# 2. Go to Project Settings -> Database -> Connection string (select URI / Node.js)
# 3. Use the connection pooling port (usually 6543, with ?pgbouncer=true) for DATABASE_URL
# 4. Use the direct port (usually 5432) for DIRECT_URL (for running migrations)
#
# DATABASE_URL="postgresql://postgres.yourprojectid:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.yourprojectid:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Next.js Node Environment
NODE_ENV="development"
